<Styles xmlns="https://github.com/avaloniaui"
		xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
	<Design.PreviewWith>
		<ThemeVariantScope RequestedThemeVariant="Dark">
			<Border Padding="20" Background="{DynamicResource PanelBackgroundBrush
			}">
				<!-- Add Controls for Previewer Here -->
				<StackPanel >
					<Button Content="Test" />
					<Button Classes="Primary" Content="Test" />
				</StackPanel>
			</Border>
		</ThemeVariantScope>

	</Design.PreviewWith>

	<!-- Add Styles Here -->

	<Style Selector="TextBlock.PanelHeader">
		<!--<Setter Property="FontSize" Value="16"/>-->
		<Setter Property="Foreground" Value="{DynamicResource PanelHeaderForeground}"/>
		<!--<Setter Property="TextAlignment" Value="Center" />-->
	</Style>

	<Style Selector="Button.Primary">
		<Setter Property="Background" Value="{DynamicResource SystemAccentColor}" />
		<Setter Property="Foreground" Value="White" />
		<!--<Setter Property="Padding" Value="15,7" />-->
	</Style>

	<Style Selector="Button.Primary:pointerover /template/ ContentPresenter#PART_ContentPresenter">
		<Setter Property="Background" Value="{DynamicResource SystemAccentColorLight1}" />
		<Setter Property="Foreground" Value="White" />
	</Style>

	<Style Selector="Button.Primary:pressed /template/ ContentPresenter#PART_ContentPresenter">
		<Setter Property="Background" Value="{DynamicResource SystemAccentColorDark1}" />
	</Style>
</Styles>
