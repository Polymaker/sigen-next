<UserControl xmlns="https://github.com/avaloniaui"
			 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
			 xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
			 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
			 mc:Ignorable="d"  d:DesignHeight="400" MinWidth="400"
			 xmlns:vm="using:SiGen.ViewModels.Dialogs"
			 xmlns:ctrl="using:SiGen.UI.Controls"
			 x:DataType="vm:EditTuningDialogViewModel"
			 xmlns:lang="using:SiGen.Lang"
			 x:Class="SiGen.UI.Dialogs.EditTuningDialogView">
	<UserControl.DataContext>
		<vm:EditTuningDialogViewModel/>
	</UserControl.DataContext>

	<Grid RowDefinitions="Auto,*,Auto" Margin="3" >
		<Grid ColumnDefinitions="*,Auto" Margin="2"
			  RowDefinitions="Auto,Auto,Auto">
			<Label Grid.Row="0"
				   Content="{x:Static lang:Resources.EditTuningDialog_TuningPresetsLabel}" VerticalAlignment="Center" />
			<ComboBox Name="TuningSelector"
					  SelectedValueBinding="{Binding Preset}"
					  ItemsSource="{Binding TuningPresets}"
					  Grid.Row="1" Grid.Column="0"
					  HorizontalAlignment="Stretch" >
				<ComboBox.ItemTemplate>
					<DataTemplate>
						<StackPanel>
							<TextBlock Grid.Column="0" Text="{Binding Name}" FontWeight="Bold" />
							<TextBlock Grid.Column="1" FontSize="12"
									   Text="{Binding Description, StringFormat='({0})'}"
									   Opacity="0.75" VerticalAlignment="Bottom"
									   Margin="5,0,0,0" Height="15"/>
						</StackPanel>
					</DataTemplate>
				</ComboBox.ItemTemplate>
				<!--<ComboBox.SelectionBoxItemTemplate>
				<DataTemplate>
				<TextBlock Text="{Binding Name}" />
				</DataTemplate>
				</ComboBox.SelectionBoxItemTemplate>-->
			</ComboBox>

			<Button Grid.Row="1" Grid.Column="1" Content="Apply"
					Command="{Binding ApplyTuningCommand}"
					CommandParameter="{Binding #TuningSelector.SelectedValue}"
					VerticalAlignment="Top" Margin="4,0,0,0">
				<Button.Styles>
					<Style Selector="Button">
						<Setter Property="IsEnabled" Value="{Binding #TuningSelector.SelectedItem, Converter={x:Static ObjectConverters.IsNotNull}}"/>
					</Style>
				</Button.Styles>
			</Button>

			<!--<Separator Grid.Row="2" Grid.ColumnSpan="2" Margin="4,1"/>-->
		</Grid>
		<Border Grid.Row="1"  CornerRadius="6" Margin="0,3,0,0"
				Background="{DynamicResource PanelBackgroundBrush}">
			<Grid RowDefinitions="Auto,Auto,*" ColumnDefinitions="*,*,*">

				<Label Content="Strings" HorizontalAlignment="Center" FontWeight="Bold" />
				<Label Content="Tuning" Grid.Column="1" HorizontalAlignment="Center" FontWeight="Bold" />
				<Label Content="Tension * " Grid.Column="2" HorizontalAlignment="Center" FontWeight="Bold" />
				<Separator Grid.Row="1" Grid.ColumnSpan="5" Margin="0,3,0,0" />

				<ItemsControl Grid.Row="2" Grid.ColumnSpan="3"
							  ItemsSource="{Binding StringCourses}"
							  >
					<ItemsControl.ItemTemplate>
						<DataTemplate>
							<Border Classes.IsEven="{Binding IsEven}">
								<Border.Styles>
									<Style Selector="Border">
										<Setter Property="Background" Value="Transparent"/>
									</Style>
									<Style Selector="Border.IsEven">
										<Setter Property="Background" Value="{DynamicResource EvenRowBrush}"/>
									</Style>
								</Border.Styles>

								<Grid ColumnDefinitions="*, *, *" >

									<StackPanel Orientation="Horizontal" Grid.Column="0">
										<ctrl:SvgIcon Margin="6,9,3,0"
													  SvgImage="/Assets/Icons/StringIcon.svg" Height="24" Opacity="0.5" VerticalAlignment="Top" />

										<TextBlock VerticalAlignment="Center" FontWeight="Bold"
												   Width="65" Margin="3,0"
												   IsVisible="{Binding IsNotGrouped}" >
											<TextBlock.Text>
												<MultiBinding StringFormat="{}{0} {1}">
													<Binding Source="{x:Static lang:Resources.StringLabel}" />
													<Binding Path="CourseNumber" />
												</MultiBinding>
											</TextBlock.Text>
										</TextBlock>
										<TextBlock VerticalAlignment="Top" FontWeight="Bold"
												   Width="80" Margin="3,10,0,0" IsVisible="{Binding IsGrouped}">
											<TextBlock.Text>
												<MultiBinding StringFormat="{}{0} {1}">
													<Binding Source="{x:Static lang:Resources.CourseLabel}" />
													<Binding Path="CourseNumber" />
												</MultiBinding>
											</TextBlock.Text>
										</TextBlock>
									</StackPanel>

									<ItemsControl ItemsSource="{Binding Strings}" Grid.Column="0" Grid.ColumnSpan="3">
										<ItemsControl.ItemTemplate>
											<DataTemplate >
												<Grid ColumnDefinitions="*,*, *">
													<!--<TextBlock Text="{Binding Label}" FontSize="12" Width="50"
													HorizontalAlignment="Right"
													IsVisible="{Binding $parent[ItemsControl].DataContext.IsGrouped}"
													Margin="3,0" VerticalAlignment="Center" >

													</TextBlock>-->
													<ctrl:NoteUpDown Grid.Column="1" HorizontalAlignment="Center"
																	 Value="{Binding Tuning, Mode=TwoWay}" Margin="0,3" Width="100" />
													<StackPanel Grid.Column="2" >
														<Label 
														   Content="{Binding StringTension, StringFormat='{}{0:0.##} lbs'}"
														   VerticalAlignment="Center" Padding="0" FontSize="13"
														   HorizontalAlignment="Center"/>
													<Label Grid.Column="2"
														   Content="{Binding StiffnessIndex, StringFormat='{}{0:0.##}'}"
														   VerticalAlignment="Center" Padding="0" FontSize="13"
														   HorizontalAlignment="Center"/>
													</StackPanel>
													
												</Grid>
											</DataTemplate>
										</ItemsControl.ItemTemplate>
									</ItemsControl>
								</Grid>
							</Border>
						</DataTemplate>
					</ItemsControl.ItemTemplate>
				</ItemsControl>
			</Grid>

		</Border>



		<Border Grid.Row="2">
			<WrapPanel HorizontalAlignment="Center" Margin="0,3,0,0" >
				<Button Classes="Primary" Content="Save" Command="{Binding SaveCommand}"
						Margin="3,0" Width="100" HorizontalContentAlignment="Center" />
				<Button Content="Cancel" Command="{Binding CancelCommand}"
						Margin="3,0" Width="100" HorizontalContentAlignment="Center" />
			</WrapPanel>
		</Border>
	</Grid>
</UserControl>
