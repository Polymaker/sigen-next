<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" 
        d:DesignWidth="200" d:DesignHeight="200" 
        MinHeight="80" MinWidth="100"
        x:Class="SiGen.UI.Dialogs.DialogHostWindow"
        xmlns:vm="using:SiGen.ViewModels.Dialogs"
        x:DataType="vm:IDialogViewModel"
        CanMinimize="False"
        CanMaximize="False"
        
        Title="{Binding Title}">
    <Window.DataContext>
        <vm:MockDialogViewModel />
    </Window.DataContext>

    <ContentPresenter Name="DialogContent" />
</Window>
