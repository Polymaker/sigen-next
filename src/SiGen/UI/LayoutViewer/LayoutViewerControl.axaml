<UserControl xmlns="https://github.com/avaloniaui"
           xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
           xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
           xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
           mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
           x:Class="SiGen.UI.LayoutViewer.LayoutViewerControl"
xmlns:ui="using:SiGen.UI"
xmlns:lv="using:SiGen.UI.LayoutViewer"
xmlns:conv="using:SiGen.Converters"
xmlns:snap="using:SiGen.Layouts.Snapping"
xmlns:lang="using:SiGen.Lang"
xmlns:materialIcons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
>
<UserControl.Resources>
  <conv:FlagsEnumConverter x:Key="FlagsEnumConverter" />
</UserControl.Resources>

<UserControl.Styles>
    <Style Selector="TextBox.measure-overlay-dark">
      <Setter Property="Foreground" Value="#FFF5F5F5" />
      <Setter Property="SelectionBrush" Value="#55FFFFFF" />
    </Style>
    <Style Selector="TextBox.measure-overlay-dark /template/ Border#PART_BorderElement">
      <Setter Property="Background" Value="#C8101010" />
    </Style>
    <Style Selector="TextBox.measure-overlay-dark:pointerover /template/ Border#PART_BorderElement">
      <Setter Property="Background" Value="#C8101010" />
    </Style>
    <Style Selector="TextBox.measure-overlay-dark:focus /template/ Border#PART_BorderElement">
      <Setter Property="Background" Value="#C8101010" />
    </Style>
    <Style Selector="TextBox.measure-overlay-dark:focus-within /template/ Border#PART_BorderElement">
      <Setter Property="Background" Value="#C8101010" />
    </Style>

    <Style Selector="TextBox.measure-overlay-light">
      <Setter Property="Foreground" Value="#FF111111" />
      <Setter Property="SelectionBrush" Value="#55336699" />
    </Style>
    <Style Selector="TextBox.measure-overlay-light /template/ Border#PART_BorderElement">
      <Setter Property="Background" Value="#EAF3F8FF" />
    </Style>
    <Style Selector="TextBox.measure-overlay-light:pointerover /template/ Border#PART_BorderElement">
      <Setter Property="Background" Value="#EAF3F8FF" />
    </Style>
    <Style Selector="TextBox.measure-overlay-light:focus /template/ Border#PART_BorderElement">
      <Setter Property="Background" Value="#EAF3F8FF" />
    </Style>
    <Style Selector="TextBox.measure-overlay-light:focus-within /template/ Border#PART_BorderElement">
      <Setter Property="Background" Value="#EAF3F8FF" />
    </Style>
  </UserControl.Styles>

  <Grid>
	  <Grid.RowDefinitions>
		  <RowDefinition Height="auto" />
		  <RowDefinition Height="*" />
		  <RowDefinition Height="auto" />
	  </Grid.RowDefinitions>
	  <Grid.ColumnDefinitions>
		  
	  </Grid.ColumnDefinitions>


	  <Border x:Name="BorderContainer" Grid.Row="0" Grid.RowSpan="3" Background="#1e3250" ZIndex="1"
			  PointerPressed="Canvas_PointerPressed"
				PointerMoved="Canvas_PointerMoved"
				PointerReleased="Canvas_PointerReleased"
				  PointerWheelChanged="Canvas_OnPointerWheel"
			  >
		  <Border.GestureRecognizers>
			  <PinchGestureRecognizer/>
		  </Border.GestureRecognizers>
		  <Grid>
			  
			  <Canvas x:Name="RenderCanvas" >
				  <ui:LayoutGridControl Width="50" Height="50" x:Name="LayoutGrid" />
			  </Canvas>
			  <Canvas x:Name="OverlayCanvas" />
		  </Grid>
		 
	  </Border>

	  <Border	
				Background="#77000000"
				ZIndex="10" Grid.Row="0"  
				HorizontalAlignment="Stretch" IsVisible="False">
		  <StackPanel Orientation="Horizontal" Spacing="4" 
					  HorizontalAlignment="Center"
					  Margin="4" >
			  <Button Content="Test" x:Name="Button1" />
			  <Button Content="Test" x:Name="Button2" />
			  <Button Content="Test" x:Name="Button3" />
			  <TextBlock x:Name="DebugText"  />
		  </StackPanel>
	  </Border>

	  <Border Grid.Row="2"  ZIndex="10" Padding="4">
		  <ThemeVariantScope x:Name="ZoomPanelThemeVariant" RequestedThemeVariant="Default">
			  <Grid ColumnDefinitions="Auto,*">
				  <StackPanel Grid.Column="0"
							  Orientation="Horizontal"
							  HorizontalAlignment="Left"
							  Spacing="4">
					  <ToggleSplitButton IsChecked="{Binding IsMeasureToolActive, RelativeSource={RelativeSource AncestorType=lv:LayoutViewerControl}, Mode=TwoWay}"
									ToolTip.Tip="{x:Static lang:Resources.MeasureTool_Tooltip}">
						  <materialIcons:MaterialIcon Kind="Ruler" IconSize="18" />
						   <!--<materialIcons:MaterialIcon Kind="RulerSquare" IconSize="18" />-->

						   <SplitButton.Flyout>
							  <MenuFlyout Opening="SnapMenuFlyout_Opening" Placement="RightEdgeAlignedBottom">
								  <MenuItem Header="{x:Static lang:Resources.MeasureTool_SnapToLabel}" FontWeight="SemiBold" IsHitTestVisible="False" />
								  <MenuItem Header="{x:Static lang:Resources.MeasureTool_SnapFilter_Frets}" 
											Click="SnapFilter_Click"
											StaysOpenOnClick="True"
											ToggleType="CheckBox"
											IsChecked="{Binding ActiveSnapFilters, RelativeSource={RelativeSource AncestorType=lv:LayoutViewerControl}, Converter={StaticResource FlagsEnumConverter}, ConverterParameter={x:Static snap:SnapLineType.Fret}, Mode=OneWay}"
											Tag="{x:Static snap:SnapLineType.Fret}">
								  </MenuItem>
								  <MenuItem Header="{x:Static lang:Resources.MeasureTool_SnapFilter_Strings}" 
											Click="SnapFilter_Click" 
											StaysOpenOnClick="True"
											ToggleType="CheckBox"
											IsChecked="{Binding ActiveSnapFilters, RelativeSource={RelativeSource AncestorType=lv:LayoutViewerControl}, Converter={StaticResource FlagsEnumConverter}, ConverterParameter={x:Static snap:SnapLineType.String}, Mode=OneWay}"
											Tag="{x:Static snap:SnapLineType.String}">
									  
								  </MenuItem>
								  <MenuItem Header="{x:Static lang:Resources.MeasureTool_SnapFilter_Fingerboard}" 
											Click="SnapFilter_Click" 
											StaysOpenOnClick="True"
											ToggleType="CheckBox" 
											IsChecked="{Binding ActiveSnapFilters, RelativeSource={RelativeSource AncestorType=lv:LayoutViewerControl}, Converter={StaticResource FlagsEnumConverter}, ConverterParameter={x:Static snap:SnapLineType.Fingerboard}, Mode=OneWay}" 
											Tag="{x:Static snap:SnapLineType.Fingerboard}">
								  </MenuItem>
								  <MenuItem Header="{x:Static lang:Resources.MeasureTool_SnapFilter_CenterLine}" 
											Click="SnapFilter_Click"
											StaysOpenOnClick="True"
											ToggleType="CheckBox"
											IsChecked="{Binding ActiveSnapFilters, RelativeSource={RelativeSource AncestorType=lv:LayoutViewerControl}, Converter={StaticResource FlagsEnumConverter}, ConverterParameter={x:Static snap:SnapLineType.CenterLine}, Mode=OneWay}"
											Tag="{x:Static snap:SnapLineType.CenterLine}">
								  </MenuItem>
							  </MenuFlyout >
						  </SplitButton.Flyout>
						 
					  </ToggleSplitButton>

				  </StackPanel>

				  <StackPanel Grid.Column="1"
							  Orientation="Horizontal"
							  HorizontalAlignment="Right"
							  Spacing="4">
					  <TextBox x:Name="ZoomTextBox" MinHeight="0" />
					  <Button x:Name="ResetViewButton" ToolTip.Tip="Reset View" Click="ResetViewButton_Click">
						  <materialIcons:MaterialIcon Kind="ImageFilterCenterFocusStrong" IconSize="18" />
					  </Button>
				  </StackPanel>
			  </Grid>
		  </ThemeVariantScope>

	  </Border>

  </Grid>
</UserControl>
