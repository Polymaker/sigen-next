<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="using:SiGen"
             x:Class="SiGen.App"
			 xmlns:materialIcons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
			 xmlns:controls="using:SiGen.UI.Controls"
			 xmlns:themes="clr-namespace:Material.Styles.Themes;assembly=Material.Styles"
             RequestedThemeVariant="Default">
             <!-- "Default" ThemeVariant follows system theme variant. "Dark" or "Light" are other available options. -->

    <Application.DataTemplates>
        <local:ViewLocator/>
    </Application.DataTemplates>

    
	<Application.Resources>
		<ResourceDictionary>
			<ResourceDictionary.MergedDictionaries>
				<ResourceInclude Source="/UI/Controls/SvgIcon.axaml"/>
				<ResourceInclude Source="/UI/Controls/CustomFormField.axaml"/>
			</ResourceDictionary.MergedDictionaries>

			<ResourceDictionary.ThemeDictionaries>
				<ResourceDictionary x:Key="Light">
					<SolidColorBrush x:Key="PanelHeaderForeground">#808080</SolidColorBrush>
				</ResourceDictionary >
				<ResourceDictionary x:Key="Dark">
					<SolidColorBrush x:Key="PanelHeaderForeground">#DFDFDF</SolidColorBrush>
				</ResourceDictionary>
			</ResourceDictionary.ThemeDictionaries>

			<x:Double x:Key="FlyoutThemeMaxWidth">1000</x:Double>
		</ResourceDictionary>
		
	</Application.Resources>

	<Application.Styles>
		<FluentTheme />
		<!--<themes:MaterialTheme PrimaryColor="Purple" SecondaryColor="Lime" />-->
		<materialIcons:MaterialIconStyles />
		<StyleInclude Source="avares://Avalonia.Controls.ColorPicker/Themes/Fluent/Fluent.xaml" />
		<Style Selector="TextBlock.PanelHeader">
			<Setter Property="FontSize" Value="16"/>
			<Setter Property="Foreground" Value="{DynamicResource PanelHeaderForeground}"/>
			<Setter Property="TextAlignment" Value="Center" />
		</Style>
	</Application.Styles>
</Application>