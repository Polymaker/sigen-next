<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:SiGen.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:views="clr-namespace:SiGen.Views"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
        x:Class="SiGen.Views.MainWindow"
		x:DataType="vm:DesktopMainViewModel"
        Icon="/Assets/SiGen16x32.ico" 
        Title="SiGen"
        Closing="Window_Closing"
        >
    <Window.KeyBindings>
		<KeyBinding Gesture="Ctrl+O" Command="{Binding OpenCommand}" />
		<KeyBinding Gesture="Ctrl+H" Command="{Binding OpenHomeCommand}" />
		<KeyBinding Gesture="Ctrl+S" Command="{Binding SaveCommand}" />
		<KeyBinding Gesture="Ctrl+Shift+S" Command="{Binding SaveAsCommand}" />
		<KeyBinding Gesture="Ctrl+," Command="{Binding ShowSettingsCommand}" />
    </Window.KeyBindings>
	<!--<views:DesktopMainView />-->
</Window>
